    "mobile": { "name": "hero-mobile", "width": 640, "height": 360, "crf": 28, "webmCrf": 41, "sizeCapMB": 1 },
    "poster": { "name": "hero-poster", "jpgQuality": 72, "webpQuality": 70, "mobileWidth": 960 }
  },
  "grade": {
    "referenceClip": 0,
    "exposure": 1.0,
    "matchBrightness": 0.8,
    "matchColour": 0.85,
    "seamRampSeconds": 1.5,
    "deflickerAbove": 0.6,
    "final": { "contrast": 1.03, "saturation": 1.1, "gamma": 1.08 }
  },
  "toolsDir": "%TEMP%/defender-hero-tools"

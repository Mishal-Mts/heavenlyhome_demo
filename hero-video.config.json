{
  "_help": "Settings for the hero background video. Edit, then run: node tools/build-hero.mjs   (see README-hero.md)",
  "sourceDir": "videos_1",
  "clips": [
    { "file": "v3.mp4", "note": "villa and beach together: opening and main clip", "start": 0.0, "end": 4.5, "speed": 0.6 },
    { "file": "v1.mp4", "note": "full beach view at sunset, then its own dissolve to a villa on the beach", "start": 0.0, "end": 2.4, "speed": 0.7 }
